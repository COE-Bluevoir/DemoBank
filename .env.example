# NorthStar Bank onboarding experience - server configuration
#
# Copy to `.env.local` and fill in the values for your environment.
# Every variable below is read and validated in src/lib/config/env.ts.
# None of these are exposed to the browser.

# ---------------------------------------------------------------------------
# Orchestration selection
# ---------------------------------------------------------------------------
# pega      : live Pega orchestration - default when PEGA_* is configured
# non-pega  : standalone comparison adapter
# mock-pega : deterministic in-process engine (tests / unconfigured local only)
ORCHESTRATION_MODE=pega

# Scenario used when a new case is created in mock/non-Pega modes.
# ADDRESS_PEP_REVIEW | HAPPY_PATH | SERVICE_TIMEOUT
DEMO_SCENARIO=ADDRESS_PEP_REVIEW

# ---------------------------------------------------------------------------
# Pega connection
# ---------------------------------------------------------------------------
# Required when ORCHESTRATION_MODE=pega. If any are missing the app refuses to
# start in pega mode instead of silently falling back to the mock engine.
#
# PEGA_BASE_URL is the root of the Pega application API, e.g.
#   https://<host>/prweb/api/application/v2  (Pega DX API v2)
PEGA_BASE_URL=
# OAuth 2.0 token endpoint, e.g. https://<host>/prweb/PRRestService/oauth2/v1/token
PEGA_TOKEN_URL=
# OAuth 2.0 client-credentials registration created for this website.
PEGA_CLIENT_ID=
PEGA_CLIENT_SECRET=

# Pega case type used to create onboarding work objects.
PEGA_CASE_TYPE_ID=ODHMNT-AgenticC-Work-CustomerOnboardingUnified

# Outbound request tuning.
PEGA_TIMEOUT_MS=5000
# File uploads to `/attachments/upload` are allowed longer than DX JSON calls.
PEGA_UPLOAD_TIMEOUT_MS=60000
PEGA_MAX_RETRIES=1
# Refresh the access token this many seconds before it actually expires.
PEGA_TOKEN_SKEW_SECONDS=60

# ---------------------------------------------------------------------------
# Downstream tool services
# ---------------------------------------------------------------------------
# Shared secret Pega must send as `x-service-api-key` when calling the
# /api/services/* tool endpoints. Leave blank to allow unauthenticated local
# development; always set a value outside local development.
SERVICE_API_KEY=

# Directory for uploaded document binaries. Defaults to .demo-data/documents.
# Used only by the `file` storage driver.
DOCUMENT_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Durable storage
# ---------------------------------------------------------------------------
# file : local disk (default) - correct for local development
# aws  : DynamoDB + S3 - REQUIRED on serverless hosting such as AWS Amplify,
#        where the filesystem is read-only and no memory is shared between
#        requests. See docs/deployment-amplify.md.
STORAGE_DRIVER=file

# Required when STORAGE_DRIVER=aws. The app refuses to start without them.
AWS_REGION=
DYNAMODB_TABLE_NAME=
S3_DOCUMENT_BUCKET=

# ---------------------------------------------------------------------------
# Internal demo/presenter surface
# ---------------------------------------------------------------------------
# Set to false to remove /demo/control and its APIs entirely.
DEMO_CONTROL_ENABLED=true
DEMO_CONTROL_PASSCODE=northstar-26

# ---------------------------------------------------------------------------
# Agent layer
# ---------------------------------------------------------------------------
# deterministic : keyword classification, no AWS needed (default)
# bedrock       : real inference via Amazon Bedrock
AGENT_PROVIDER=deterministic

# Credentials come from the AWS default provider chain - use a named profile
# (`aws configure --profile <name>`), never values in this file.
AWS_PROFILE=
BEDROCK_REGION=us-east-1

# Routing and classification: called every turn, so a small model.
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
# Grounded reasoning: a small model cannot reliably hold the output contract.
BEDROCK_REASONING_MODEL_ID=amazon.nova-pro-v1:0
