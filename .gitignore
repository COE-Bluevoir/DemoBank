# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
~$*.pptx
~$*.docx
~$*.xlsx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# local app state
/.demo-data

# local agent harness settings
/.claude/

# amplify manual deployment artefacts
/.amplify-hosting
/amplify-bundle.zip

# Scratch files written by verification scripts. One of these held a service
# API key, so they are excluded rather than tidied up by hand each time.
*.tmp

# Pega's own application documentation. It carries a Pegasystems notice
# restricting copying and distribution, and these repositories are public, so
# the files stay local. docs/pega-step-contract.md records what we observed
# from the API instead.
*.docx
